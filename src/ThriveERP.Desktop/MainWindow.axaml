<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ThriveERP.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="ThriveERP.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ThriveERP - Modern Enterprise Management"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- TOP NAVBAR / HEADER -->
            <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Height="65">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
                    <!-- Brand / Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Background="{DynamicResource AppAccentPrimary}" CornerRadius="8" Width="32" Height="32">
                            <TextBlock Text="◆" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ThriveERP" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource AppTextPrimary}"/>
                            <TextBlock Text="Enterprise Suite" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Global Search with Interactive Dropdown -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <TextBox PlaceholderText="Search products, customers, orders... (Ctrl+K)" 
                                 Text="{Binding GlobalSearchQuery}"
                                 CornerRadius="8" Padding="12,8"
                                 Background="{DynamicResource AppCardBackground}"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 BorderThickness="1"/>

                        <!-- Search Dropdown Overlay -->
                        <Popup IsOpen="{Binding IsSearchDropdownOpen}" Topmost="True" PlacementTarget="{Binding $parent[TextBox]}" Width="420">
                            <Border Background="{DynamicResource AppCardBackground}" 
                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                    BorderThickness="1" CornerRadius="8" 
                                    BoxShadow="0 4 20 0 #20000000" Margin="0,4,0,0">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Search Results" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" Margin="5,0,0,5"/>
                                    <ListBox ItemsSource="{Binding GlobalSearchResults}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:GlobalSearchResultViewModel">
                                                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSearchResultCommand}" CommandParameter="{Binding}"
                                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="8,6" CornerRadius="6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{DynamicResource AppHoverBackground}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                             
                    <!-- Right Navbar: Theme Selector, Notifications & Profile -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                        
                        <!-- Theme Switcher Combo -->
                        <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" 
                                  Width="180" CornerRadius="6" FontSize="12" Padding="8,4" VerticalAlignment="Center"/>

                        <!-- Interactive Notifications Drawer Button -->
                        <Panel VerticalAlignment="Center">
                            <Button Command="{Binding ToggleNotificationsCommand}" Classes="outline" Padding="10,6" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔔" FontSize="14"/>
                                    <TextBlock Text="Alerts" FontSize="12" FontWeight="SemiBold"/>
                                    <Border Background="#EF4444" CornerRadius="10" Padding="6,1" IsVisible="{Binding UnreadNotificationCount}">
                                        <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Notifications Popup Flyout -->
                            <Popup IsOpen="{Binding IsNotificationFlyoutOpen}" Topmost="True" Width="360">
                                <Border Background="{DynamicResource AppCardBackground}" 
                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                        BorderThickness="1" CornerRadius="10" Padding="15"
                                        BoxShadow="0 8 30 0 #25000000" Margin="0,5,0,0">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                                            <TextBlock Grid.Column="0" Text="Notifications" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                                            <Button Grid.Column="1" Content="Mark Read" Command="{Binding MarkAllNotificationsReadCommand}" Classes="outline" FontSize="11" Padding="8,3" Margin="0,0,5,0"/>
                                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearNotificationsCommand}" Classes="outline" FontSize="11" Padding="8,3"/>
                                        </Grid>
                                        <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,10"/>
                                        
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsControl ItemsSource="{Binding Notifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:NotificationItemViewModel">
                                                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectNotificationCommand}" CommandParameter="{Binding}"
                                                                Background="Transparent" HorizontalAlignment="Stretch" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AppHoverBackground}" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppTextPrimary}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding TimeAgo}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="No unread notifications" IsVisible="{Binding !Notifications.Count}" 
                                                   FontStyle="Italic" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="10"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Panel>

                        <!-- User Profile Badge -->
                        <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="20" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="👤" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentUserName}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" FontSize="13"/>
                                <Button Content="Logout" Command="{Binding LogoutCommand}" Background="Transparent" Foreground="#E11D48" FontWeight="SemiBold" VerticalAlignment="Center" Padding="5,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA WITH SIDEBAR -->
            <SplitView Grid.Row="1" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="240" PaneBackground="{DynamicResource AppSidebarBackground}">
                <SplitView.Pane>
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer Margin="10,15,10,0">
                            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedListItem}" 
                                     Background="Transparent" Foreground="{DynamicResource AppTextPrimary}" SelectionMode="Single"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" CornerRadius="8" Margin="0,2">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="◆" FontSize="12" Foreground="{DynamicResource AppAccentPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </SplitView.Pane>

                <SplitView.Content>
                    <!-- Inner Page Content Surface -->
                    <Border Background="{DynamicResource AppSurfaceBackground}">
                        <TransitioningContentControl Content="{Binding CurrentPage}" />
                    </Border>
                </SplitView.Content>
            </SplitView>

            <!-- FOOTER / BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="#1E293B" Height="32" Padding="15,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="🟢 DB Connected" Foreground="#4ADE80" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="SQLite (Local Encrypted)" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="2" Text="ThriveERP v1.1.0-interactive" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- TOAST NOTIFICATION OVERLAY -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,75,25,0"
                Background="#1E293B" CornerRadius="8" Padding="16,10" BoxShadow="0 4 15 0 #40000000"
                IsVisible="{Binding IsToastVisible}" ZIndex="999">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="ℹ️" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- LICENSE LOCK SCREEN OVERLAY -->
        <Border Background="#E60F172A" IsVisible="{Binding IsLicenseLocked}" ZIndex="1000">
            <Border Background="{DynamicResource AppSurfaceBackground}" 
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" 
                    Padding="30" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Width="500"
                    BoxShadow="0 10 40 0 #50000000">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="24"/>
                        <TextBlock Text="ThriveERP Activation Required" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding LicenseErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10"/>
                    
                    <TextBlock Text="Please paste your License Key string below to continue using the software." Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <TextBox Text="{Binding LicenseKeyInput}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" CornerRadius="8" PlaceholderText="Paste License Key here..."/>
                    
                    <Button Content="Activate License" Command="{Binding ActivateLicenseCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
