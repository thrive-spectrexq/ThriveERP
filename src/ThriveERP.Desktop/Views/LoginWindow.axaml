<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ThriveERP.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        x:Class="ThriveERP.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Login - ThriveERP"
        Background="{DynamicResource AppWindowBackground}">

  <Design.DataContext>
    <vm:LoginViewModel/>
  </Design.DataContext>

  <Grid ColumnDefinitions="*, *">
    
    <!-- Left Side: Branding / Imagery -->
    <Border Grid.Column="0" Background="#1E293B">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Margin="40">
        <Border Background="#3B82F6" CornerRadius="16" Width="64" Height="64" HorizontalAlignment="Center">
          <TextBlock Text="◆" FontSize="36" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="ThriveERP" FontSize="36" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
        <TextBlock Text="Offline-first enterprise resource planning, designed for speed, security, and reliability." 
                   Foreground="#94A3B8" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Right Side: Login Form -->
    <Border Grid.Column="1" Background="{DynamicResource AppWindowBackground}">
      <StackPanel VerticalAlignment="Center" Margin="60" Spacing="20">
        <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
        <TextBlock Text="Please sign in to your enterprise workstation." FontSize="14" Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,10"/>
        
        <StackPanel Spacing="6">
          <TextBlock Text="Username" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
          <TextBox Text="{Binding Username}" PlaceholderText="Enter your username (e.g. admin)" FontSize="15" Padding="12" CornerRadius="8"/>
        </StackPanel>

        <StackPanel Spacing="6" Margin="0,10,0,0">
          <TextBlock Text="Password" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
          <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Enter your password" FontSize="15" Padding="12" CornerRadius="8"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#EF4444" FontWeight="Medium" Margin="0,5"/>

        <Button Content="Sign In to Workstation" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsLoading}"
                Classes="accent" FontSize="15" FontWeight="Bold" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="14" CornerRadius="8" Margin="0,15,0,0">
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
