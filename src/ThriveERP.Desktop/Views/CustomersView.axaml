<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ThriveERP.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ThriveERP.Desktop.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <Panel>
    <DockPanel Background="Transparent">
      <!-- Toolbar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource AppHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="15,10">
        <Grid ColumnDefinitions="Auto, *, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
            <ComboBox ItemsSource="{Binding CustomerFilters}" SelectedItem="{Binding SelectedFilter}" Width="160" CornerRadius="6" FontSize="12"/>
          </StackPanel>
          
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
            <TextBox PlaceholderText="Search customers..." Text="{Binding SearchQuery}" Width="220" VerticalAlignment="Center" CornerRadius="6"/>
            <Button Content="↻ Refresh" Command="{Binding LoadCustomersCommand}" Classes="outline"/>
            <Button Content="+ New Customer" Command="{Binding ShowAddCustomerCommand}" Classes="accent"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main Split View -->
      <Grid ColumnDefinitions="*, 4, 380">
        
        <!-- Left: DataGrid -->
        <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" Margin="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
          <DataGrid ItemsSource="{Binding FilteredCustomers}" 
                    SelectedItem="{Binding SelectedCustomer}"
                    AutoGenerateColumns="False" 
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    RowBackground="Transparent">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140" />
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" />
              <DataGridTextColumn Header="Current Balance" Binding="{Binding CurrentBalance, StringFormat={}{0:C}}" Width="130" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

        <!-- Right: Detail Panel -->
        <Border Grid.Column="2" Background="{DynamicResource AppCardBackground}" Margin="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
          <Panel>
            <!-- Empty State -->
            <TextBlock IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Select a customer to view profile &amp; order history"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
            
            <!-- Detail Content -->
            <Grid RowDefinitions="Auto, *" IsVisible="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}">
              
              <!-- Header -->
              <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="{Binding SelectedCustomer.Email}" FontSize="13" Foreground="{DynamicResource AppTextSecondary}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="📄 Export Statement" Command="{Binding ExportStatementCommand}" Classes="outline" FontSize="11" Padding="10,5"/>
                    <Button Content="💳 Record Payment" Command="{Binding OpenRecordPaymentCommand}" Classes="accent" FontSize="11" Padding="10,5"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Tabs -->
              <TabControl Grid.Row="1" Margin="5">
                <!-- Tab 1: Info -->
                <TabItem Header="General Info">
                  <ScrollViewer>
                    <StackPanel Spacing="12" Margin="10">
                      <StackPanel>
                        <TextBlock Text="Phone Number" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCustomer.Phone}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource AppTextPrimary}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Billing Address" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCustomer.Address}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimary}"/>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Credit Limit" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                          <TextBlock Text="{Binding SelectedCustomer.CreditLimit, StringFormat={}{0:C}}" FontSize="13" Margin="0,2,0,0" Foreground="{DynamicResource AppTextPrimary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Current Balance" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondary}" FontSize="11"/>
                          <TextBlock Text="{Binding SelectedCustomer.CurrentBalance, StringFormat={}{0:C}}" FontSize="14" Margin="0,2,0,0" FontWeight="ExtraBold" Foreground="#EF4444"/>
                        </StackPanel>
                      </Grid>
                      
                      <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,5"/>
                      
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="✏️ Edit" Command="{Binding EditCustomerCommand}" CommandParameter="{Binding SelectedCustomer}" Classes="outline" Padding="12,6"/>
                        <Button Content="🗑️ Delete" Command="{Binding DeleteCustomerCommand}" CommandParameter="{Binding SelectedCustomer}" Classes="outline" Foreground="#EF4444" Padding="12,6"/>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>
                
                <!-- Tab 2: Orders History -->
                <TabItem Header="Sales Orders">
                  <Grid>
                    <TextBlock Text="No orders found for this customer" IsVisible="{Binding !SelectedCustomerOrders.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                    <DataGrid ItemsSource="{Binding SelectedCustomerOrders}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" IsVisible="{Binding SelectedCustomerOrders.Count}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='{}{0:d}'}" Width="100" />
                        <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:C}}" Width="100" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </TabItem>
              </TabControl>

            </Grid>
          </Panel>
        </Border>
      </Grid>
    </DockPanel>

    <!-- Quick Record Payment Overlay -->
    <Grid Background="#80000000" IsVisible="{Binding ShowPaymentModal}" ZIndex="100">
      <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Record Customer Payment" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
          <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='Customer: {0}'}" FontSize="13" Foreground="{DynamicResource AppTextSecondary}"/>
          
          <TextBlock Text="Payment Amount:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
          <NumericUpDown Value="{Binding PaymentAmount}" Minimum="1" Increment="10" FormatString="C"/>

          <TextBlock Text="Reference / Note:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
          <TextBox Text="{Binding PaymentNote}" PlaceholderText="e.g. Check #1042, Wire transfer..." />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Command="{Binding CancelRecordPaymentCommand}" Classes="outline"/>
            <Button Content="Record Payment" Command="{Binding ConfirmRecordPaymentCommand}" Classes="accent"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Overlay for Add/Edit -->
    <Border Background="#80000000" IsVisible="{Binding CurrentOverlay, Converter={x:Static ObjectConverters.IsNotNull}}" ZIndex="100">
      <ContentControl Content="{Binding CurrentOverlay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Panel>
</UserControl>
