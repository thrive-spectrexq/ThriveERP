<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ThriveERP.Desktop.ViewModels"
             xmlns:views="clr-namespace:ThriveERP.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ThriveERP.Desktop.Views.AccountingView"
             x:DataType="vm:AccountingViewModel"
             Background="Transparent">

  <Grid>
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsAddingExpense}" Margin="20">
      <!-- Header -->
      <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15" BoxShadow="0 2 10 0 #0D000000">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Accounting &amp; Finance" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
            <TextBlock Text="General Ledger, Chart of Accounts, &amp; Expense Tracking" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
          </StackPanel>
          
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Width="150" CornerRadius="6" FontSize="12"/>
            <Button Content="+ Add Expense" Command="{Binding ShowAddExpenseCommand}" Classes="accent"/>
            <Button Content="↻ Refresh" Command="{Binding LoadDataCommand}" Classes="outline"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Content -->
      <TabControl Grid.Row="1" Margin="0">
        <!-- Financial Summary Tab -->
        <TabItem Header="P&amp;L Summary">
          <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,10,0,0">
            <StackPanel Spacing="20">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Profit and Loss Overview" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedPeriod}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
              </Grid>
              
              <UniformGrid Columns="3">
                <!-- Total Income -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Total Income" FontSize="14" Foreground="#166534" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:C}}" FontSize="26" Foreground="#15803D" FontWeight="ExtraBold"/>
                  </StackPanel>
                </Border>
                
                <!-- Total Expenses -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Total Expenses" FontSize="14" Foreground="#991B1B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:C}}" FontSize="26" Foreground="#B91C1C" FontWeight="ExtraBold"/>
                  </StackPanel>
                </Border>
                
                <!-- Net Profit -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Net Profit" FontSize="14" Foreground="#1E40AF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding NetProfit, StringFormat={}{0:C}}" FontSize="26" Foreground="#1D4ED8" FontWeight="ExtraBold"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>
        </TabItem>

        <!-- Accounts Tab -->
        <TabItem Header="Chart of Accounts">
          <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Account Type" Binding="{Binding Type}" Width="180" />
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat={}{0:C}}" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </TabItem>

        <!-- Expenses Tab -->
        <TabItem Header="Expense Log">
          <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat='{}{0:d}'}" Width="130" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="140" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <Panel IsVisible="{Binding IsAddingExpense}" ZIndex="100">
      <views:AddExpenseView DataContext="{Binding AddExpenseViewModel}" />
    </Panel>
  </Grid>
</UserControl>
