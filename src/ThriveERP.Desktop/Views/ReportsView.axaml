<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThriveERP.Desktop.ViewModels"
             x:Class="ThriveERP.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel"
             Background="Transparent">
    
    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15" BoxShadow="0 2 10 0 #0D000000">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Generate PDF &amp; Excel business reports with live preview metrics" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" Width="200" CornerRadius="6" FontSize="12"/>
                    <CalendarDatePicker SelectedDate="{Binding SelectedDate}" CornerRadius="6" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Body Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="*,360" Margin="0">
            <!-- Left: Live Preview Card -->
            <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,10,0">
                <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Live Report Summary Preview" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                        <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="12" Padding="10,3">
                            <TextBlock Text="{Binding SelectedReportType}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="3">
                        <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Total Sales Revenue" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Text="{Binding PreviewTotalRevenue}" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Orders Processed" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Text="{Binding PreviewOrderCount}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Average Order Value" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Text="{Binding PreviewAverageOrder}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Distribution Summary" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" Margin="0,10,0,0"/>
                    <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="15">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Direct POS Cash Sales (70%)" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Passed Audit" FontSize="11" Foreground="#10B981" FontWeight="Bold"/>
                            </Grid>
                            <Border Height="8" Background="#3B82F6" CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Export Options Panel -->
            <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="25" Margin="10,0,0,0">
                <StackPanel Spacing="18">
                    <TextBlock Text="Export Options" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="Export complete document formatted for printing or spreadsheet analysis." FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                    
                    <Button Content="📄 Export PDF Document" Command="{Binding GeneratePdfCommand}" Classes="accent" FontSize="14" Padding="15,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="📊 Export Excel Spreadsheet" Command="{Binding GenerateExcelCommand}" Classes="outline" FontSize="14" Padding="15,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    
                    <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,5"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppAccentPrimary}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
