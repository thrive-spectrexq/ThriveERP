<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ThriveERP.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ThriveERP.Desktop.Views.SalesView"
             x:Name="SalesRoot"
             x:DataType="vm:SalesViewModel">
  <Panel>
    <TabControl Background="Transparent" Padding="0">
      
      <!-- TAB 1: POS TERMINAL -->
      <TabItem Header="POS Terminal">
        <Grid ColumnDefinitions="*, 420" Background="Transparent">
          
          <!-- POS Left Side: Products Grid & Filter Bar -->
          <DockPanel Grid.Column="0" Margin="15">
            <!-- Search & Category Filters Header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" BoxShadow="0 2 10 0 #0D000000" Margin="0,0,0,15">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBox Grid.Column="0" PlaceholderText="Search products by name, SKU, or barcode..." Text="{Binding SearchQuery}" FontSize="15" Padding="10"/>
                  <Button Grid.Column="1" Content="Search &amp; Add" Command="{Binding SearchAndAddCommand}" Classes="accent" Padding="15,8" Margin="10,0,0,0"/>
                </Grid>

                <!-- Category Filter Chips Bar -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding}" 
                                Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).SetSelectedCategoryCommand}" CommandParameter="{Binding}"
                                Classes="chip"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <!-- Product Cards Grid -->
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding PosProducts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).AddToCartCommand}" CommandParameter="{Binding}"
                            Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="6" Padding="0" Width="165" Height="150" Cursor="Hand">
                      <Grid RowDefinitions="*, Auto">
                        <Border Grid.Row="0" Background="{DynamicResource AppHoverBackground}" CornerRadius="10,10,0,0">
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="10" Background="Transparent">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}" TextTrimming="CharacterEllipsis"/>
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="{Binding SellingPrice, StringFormat={}{0:C}}" FontSize="14" Foreground="#3B82F6" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="+ Add" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- POS Right Side: Cart / Checkout -->
          <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BoxShadow="-4 0 15 0 #0D000000">
            <DockPanel>
              <!-- Cart Header -->
              <Border DockPanel.Dock="Top" Background="{DynamicResource AppHeaderBackground}" Padding="15" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="🛒" FontSize="18"/>
                      <TextBlock Text="Current Order Cart" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear Cart" Command="{Binding ClearCartCommand}" Classes="outline" Foreground="#EF4444" FontSize="12" Padding="10,4"/>
                  </Grid>

                  <!-- Customer Assignment Selector -->
                  <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedItem="{Binding SelectedCustomer}" PlaceholderText="👤 Select Customer (Walk-in)" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name, StringFormat='👤 {0}'}" FontSize="12"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- Barcode Quick Entry -->
                  <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" PlaceholderText="🔍 Scan / Enter Barcode or SKU..." Text="{Binding BarcodeQuery}" FontSize="12">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddByBarcodeCommand}"/>
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Add" Command="{Binding AddByBarcodeCommand}" Classes="accent" FontSize="11" Padding="10,4" Margin="5,0,0,0"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Totals & Checkout Panel (Bottom) -->
              <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppHeaderBackground}" Padding="18" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}">
                <StackPanel Spacing="8">
                  <!-- Quick Discount Pills -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,5">
                    <TextBlock Text="Discount:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontWeight="SemiBold"/>
                    <Button Content="0%" Command="{Binding SetDiscountCommand}" CommandParameter="0" Classes="chip" Padding="8,3"/>
                    <Button Content="5%" Command="{Binding SetDiscountCommand}" CommandParameter="5" Classes="chip" Padding="8,3"/>
                    <Button Content="10%" Command="{Binding SetDiscountCommand}" CommandParameter="10" Classes="chip" Padding="8,3"/>
                    <Button Content="15%" Command="{Binding SetDiscountCommand}" CommandParameter="15" Classes="chip" Padding="8,3"/>
                    <Button Content="20%" Command="{Binding SetDiscountCommand}" CommandParameter="20" Classes="chip" Padding="8,3"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Subtotal:" FontSize="14" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:C}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                  </Grid>
                  
                  <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding DiscountAmount}">
                    <TextBlock Grid.Column="0" Text="Discount Savings:" FontSize="14" Foreground="#10B981"/>
                    <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:C}'}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                  </Grid>

                  <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Tax (10%):" FontSize="14" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Tax, StringFormat={}{0:C}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}"/>
                  </Grid>

                  <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>

                  <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Total:" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:C}}" FontSize="22" FontWeight="ExtraBold" Foreground="#3B82F6"/>
                  </Grid>
                  
                  <Button Content="💳 CHECKOUT NOW" Command="{Binding CheckoutCommand}" Classes="accent" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="15" Margin="0,10,0,0" CornerRadius="8"/>
                </StackPanel>
              </Border>

              <!-- Cart Items List with Quantity Controls -->
              <ListBox ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0" Margin="5">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CartItemViewModel">
                    <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding UnitPrice, StringFormat='Unit: {0:C}'}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <!-- Quantity Adjuster Controls -->
                          <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Button Content="-" Command="{Binding DecrementQuantityCommand}" Classes="outline" Padding="6,2" FontSize="12"/>
                              <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Padding="6,0"/>
                              <Button Content="+" Command="{Binding IncrementQuantityCommand}" Classes="outline" Padding="6,2" FontSize="12"/>
                            </StackPanel>
                          </Border>

                          <TextBlock Text="{Binding LineTotal, StringFormat={}{0:C}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" Width="70" TextAlignment="Right"/>
                          <Button Content="✕" Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).RemoveFromCartCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" FontSize="14" Padding="4" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 2: SALES ORDERS HISTORY -->
      <TabItem Header="Sales Orders (History)">
        <DockPanel Background="Transparent">
          <!-- Toolbar & Filter Chips -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource AppHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="15,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="Order History" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding OrderStatusFilters}" SelectedItem="{Binding SelectedOrderStatusFilter}" Width="150" CornerRadius="6" FontSize="12"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <TextBox PlaceholderText="Search order number..." Text="{Binding SalesOrderSearchQuery}" Width="220" VerticalAlignment="Center" CornerRadius="6"/>
                <Button Content="+ New Order" Command="{Binding ShowAddSalesOrderCommand}" Classes="accent"/>
                <Button Content="↻ Refresh" Command="{Binding LoadSalesOrdersCommand}" Classes="outline"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Main Split View -->
          <Grid ColumnDefinitions="*, 4, 520">
            
            <!-- Left: DataGrid -->
            <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" Margin="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
              <DataGrid ItemsSource="{Binding FilteredSalesOrders}" 
                        SelectedItem="{Binding SelectedSalesOrder}"
                        AutoGenerateColumns="False" 
                        IsReadOnly="True"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        RowBackground="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="130"/>
                  <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='{}{0:g}'}" Width="150" />
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                  <DataGridTextColumn Header="Total Amount" Binding="{Binding GrandTotal, StringFormat={}{0:C}}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <!-- Right: Detail Panel -->
            <Border Grid.Column="2" Background="{DynamicResource AppCardBackground}" Margin="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
              <Panel>
                <!-- Empty State -->
                <TextBlock IsVisible="{Binding SelectedSalesOrder, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="Select a sales order from the table to view line items"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" FontSize="13"/>
                
                <!-- Detail Content -->
                <Grid RowDefinitions="Auto, *" IsVisible="{Binding SelectedSalesOrder, Converter={x:Static ObjectConverters.IsNotNull}}">
                  
                  <!-- Header -->
                  <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}" Padding="15">
                    <Grid ColumnDefinitions="*, Auto">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding SelectedSalesOrder.OrderNumber}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Border Background="#DBEAFE" CornerRadius="12" Padding="8,2">
                            <TextBlock Text="{Binding SelectedSalesOrder.Status}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                          </Border>
                          <TextBlock Text="{Binding SelectedSalesOrder.OrderDate, StringFormat='{}{0:g}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                      
                      <!-- Action Buttons -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="🖨️ Print Receipt" Command="{Binding PrintReceiptCommand}" Classes="outline" Padding="12,6"/>
                        <Button Content="📄 Export PDF Invoice" Command="{Binding ExportInvoiceCommand}" Classes="accent" Padding="12,6"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Line Items Table -->
                  <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedOrderItems}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" Margin="5">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                      <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                      <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="90" />
                      <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="90" />
                      <DataGridTemplateColumn Header="Actions" Width="85">
                          <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                  <Button Content="Return" Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).InitiateReturnCommand}" CommandParameter="{Binding}" Classes="outline" Foreground="#EF4444" FontSize="11" Padding="6,3"/>
                              </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Panel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- TAB 3: RETURNS & REFUNDS LOG -->
      <TabItem Header="Returns &amp; Refunds">
        <DockPanel Margin="15">
          <!-- Header Bar -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15" BoxShadow="0 2 10 0 #0D000000">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="↩️ Returns &amp; Refunds Audit Log" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
                <TextBlock Text="Track item returns, reason codes, restocking, and customer credit notes" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
              </StackPanel>
              <Button Grid.Column="1" Content="↻ Refresh Log" Command="{Binding LoadReturnsLogCommand}" Classes="outline" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Returns Table -->
          <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DataGrid ItemsSource="{Binding ReturnsLog}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0" RowBackground="Transparent">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="120" />
                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" />
                <DataGridTextColumn Header="Refund Total" Binding="{Binding RefundAmount, StringFormat='-{0:C}'}" Width="120" Foreground="#EF4444" FontWeight="Bold"/>
                <DataGridTextColumn Header="Return Reason" Binding="{Binding Reason}" Width="220" />
                <DataGridTextColumn Header="Processed Date" Binding="{Binding ProcessedAtUtc, StringFormat='{}{0:g}'}" Width="150" />
                <DataGridTemplateColumn Header="Credit Note" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="📄 PDF Slip" Command="{Binding $parent[UserControl].((vm:SalesViewModel)DataContext).ExportCreditNoteCommand}" CommandParameter="{Binding}" Classes="outline" FontSize="11" Padding="6,3"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- Payment Overlay Modal with Cash Presets -->
    <Grid Background="#80000000" IsVisible="{Binding ShowPaymentOverlay}" ZIndex="100">
        <Border Background="{DynamicResource AppCardBackground}" 
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Width="420" Padding="25" BoxShadow="0 8 30 0 #40000000">
            <StackPanel Spacing="15">
                <TextBlock Text="Complete Payment" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextPrimary}"/>
                
                <TextBlock Text="{Binding GrandTotal, StringFormat='Total Due: {0:C}'}" FontSize="24" FontWeight="ExtraBold" Foreground="#3B82F6" HorizontalAlignment="Center"/>

                <!-- Customer Details (Optional) -->
                <Border Background="{DynamicResource AppHoverBackground}" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                      <TextBlock Grid.Column="0" Text="👤 Customer Details (Optional)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimary}"/>
                      <TextBlock Grid.Column="1" Text="Walk-in Default" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*, *">
                      <TextBox Grid.Column="0" PlaceholderText="Name (Optional)" Text="{Binding CustomerNameInput}" FontSize="12" Margin="0,0,4,0"/>
                      <TextBox Grid.Column="1" PlaceholderText="Phone (Optional)" Text="{Binding CustomerPhoneInput}" FontSize="12" Margin="4,0,0,0"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                    <TextBlock Text="Payment Method:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" 
                              SelectedItem="{Binding SelectedPaymentMethod}" 
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Cash Presets & Tendered Amount -->
                <StackPanel Spacing="8" IsVisible="{Binding SelectedPaymentMethod, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Cash'}">
                    <TextBlock Text="Quick Tender Presets:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Exact" Command="{Binding SetCashPresetCommand}" CommandParameter="Exact" Classes="chip" Margin="0,0,5,5"/>
                      <Button Content="$10" Command="{Binding SetCashPresetCommand}" CommandParameter="10" Classes="chip" Margin="0,0,5,5"/>
                      <Button Content="$20" Command="{Binding SetCashPresetCommand}" CommandParameter="20" Classes="chip" Margin="0,0,5,5"/>
                      <Button Content="$50" Command="{Binding SetCashPresetCommand}" CommandParameter="50" Classes="chip" Margin="0,0,5,5"/>
                      <Button Content="$100" Command="{Binding SetCashPresetCommand}" CommandParameter="100" Classes="chip" Margin="0,0,5,5"/>
                    </WrapPanel>

                    <TextBlock Text="Amount Tendered:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                    <NumericUpDown Value="{Binding AmountTendered}" Minimum="0" Increment="1" FormatString="C"/>

                    <TextBlock Text="Change Due:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
                    <TextBlock Text="{Binding ChangeAmount, StringFormat={}{0:C}}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                    <Button Content="Cancel" Command="{Binding CancelPaymentCommand}" Classes="outline"/>
                    <Button Content="Confirm &amp; Print Receipt" Command="{Binding ConfirmPaymentCommand}" Classes="accent"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Return Overlay Modal -->
    <Grid Background="#80000000" IsVisible="{Binding ShowReturnOverlay}" ZIndex="100">
      <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="25" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Process Item Return" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}"/>
          
          <TextBlock Text="{Binding SelectedSaleItemForReturn.ProductName, StringFormat='Product: {0}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
          <TextBlock Text="{Binding SelectedSaleItemForReturn.Quantity, StringFormat='Available to return: {0}'}" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" />
          
          <TextBlock Text="Return Quantity:" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
          <NumericUpDown Value="{Binding ReturnQuantity}" Minimum="1" Maximum="{Binding SelectedSaleItemForReturn.Quantity}" Increment="1"/>
          
          <TextBlock Text="Return Reason:" FontSize="13" Foreground="{DynamicResource AppTextPrimary}"/>
          <TextBox Text="{Binding ReturnReason}" PlaceholderText="e.g. Defective item, customer refund request..." Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
          
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Cancel" Command="{Binding CancelReturnCommand}" Classes="outline" />
            <Button Content="Confirm Return" Command="{Binding ProcessReturnCommand}" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Overlay for Add Sales Order -->
    <Border Background="#80000000" IsVisible="{Binding CurrentOverlay, Converter={x:Static ObjectConverters.IsNotNull}}" ZIndex="100">
      <ContentControl Content="{Binding CurrentOverlay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Panel>
</UserControl>
